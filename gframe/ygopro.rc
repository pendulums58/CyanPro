#ifdef __MINGW32__
#include <winuser.h>
1 RT_MANIFEST "ygopro.exe.manifest"
#endif

1 ICON "cyanpro.ico"

1 VERSIONINFO
FILEVERSION 1, 0, 0, 0
PRODUCTVERSION 1, 0, 0, 0
FILEOS 0x4
FILETYPE 0x1

BEGIN
	BLOCK "StringFileInfo"
	BEGIN
		BLOCK "000904b0"
		BEGIN
			VALUE "OriginalFilename", "CyanPro.exe"
			VALUE "InternalName", "ygoprodll"
			VALUE "FileVersion", "1.0.0.0"
			VALUE "ProductName", "CyanPro"
			VALUE "ProductVersion", "1.0.0.0"
			VALUE "LegalCopyright", "Copyright (C) 2020-2026 edo9300 and others"
			VALUE "CompanyName", "CyanPro"
			VALUE "FileDescription", "CyanPro, automatic duel simulator"
		END
	END
	BLOCK "VarFileInfo"
	BEGIN
		VALUE "Translation", 0x9, 1200
	END
END
